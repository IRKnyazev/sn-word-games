{
  "name": "SupernotePuzzles",
  "version": "0.1.0",
  "description": "Play NYT puzzles and Minute Cryptic with the pen on a real Supernote note page.",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test",
    "render-templates": "tsx scripts/render-templates.ts",
    "build": "rm -rf build && bash buildPlugin.sh"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-fs": "2.20.0",
    "sn-plugin-lib": "^0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/jest": "^29.5.13",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "pngjs": "7.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "tsx": "4.23.15",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
